{
  "name": "geostyler-web-components",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Component wrapper around the GeoStyler <Style> React component.",
  "license": "BSD-2-Clause",
  "author": "GeoStyler contributors",
  "homepage": "TODO",
  "repository": {
    "type": "git",
    "url": "TODO"
  },
  "bugs": {
    "url": "TODO"
  },
  "keywords": [
    "geostyler",
    "web-component"
  ],
  "sideEffects": [
    "./dist/geostyler-web-component.js"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "test": "vitest run"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./geostyler-web-component": {
      "types": "./dist/geostyler-web-component.d.ts",
      "default": "./dist/geostyler-web-component.js"
    }
  },
  "typesVersions": {
    "*": {
      "geostyler-web-component": [
        "dist/geostyler-web-component.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@r2wc/react-to-web-component": "^2.1.1",
    "geostyler": "^18.6.0",
    "geostyler-geojson-parser": "^2.0.0",
    "lodash": "^4.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": ">=19.x",
    "@types/react-dom": ">=19.x",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
